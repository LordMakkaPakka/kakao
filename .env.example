# Adres bazy Postgres — wystarczy jedna z tych zmiennych:
DATABASE_URL="postgresql://user:haslo@host/baza?sslmode=require"
# POSTGRES_URL="postgresql://user:haslo@host/baza?sslmode=require"

# Opcjonalnie: magazyn plików Vercel Blob (duże filmy poza bazą).
# Włącz Storage → Blob w Vercelu, a token wklej tutaj.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Opcjonalnie: wymuś sposób trzymania fragmentów uploadu.
# "db" — działa na każdej platformie serverless (Vercel ustawia to sam),
# "disk" — lokalny dysk / /tmp (domyślnie poza Vercel).
# POLHUB_UPLOAD_STORAGE="db"
